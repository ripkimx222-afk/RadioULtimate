local spamActive = false
local spamCoroutine = nil
local isSpamRunning = false
local taskWait = task.wait

local function SpamLoop()
    isSpamRunning = true
    local waitTime = getgenv().SpamInterval or 0
    while spamActive do
        SendPureParry()
        taskWait(waitTime)
    end
    isSpamRunning = false
end

local function ToggleSpam(state)
    spamActive = state
    if state and not isSpamRunning then
        isSpamRunning = true
        task.spawn(SpamLoop)
    elseif not state and isSpamRunning then
        isSpamRunning = false
    end
end

StatusBtn.MouseButton1Click:Connect(function()
    ToggleSpam(not spamActive)
    StatusBtn.Text = spamActive and "ACTIVE" or "FALSE"
    StatusBtn.TextColor3 = spamActive and Color3.new(0, 255, 0) or Color3.fromRGB(120, 0, 0)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode.Name == "E" then
        ToggleSpam(not spamActive)
        StatusBtn.Text = spamActive and "ACTIVE" or "FALSE"
        StatusBtn.TextColor3 = spamActive and Color3.new(0, 255, 0) or Color3.fromRGB(120, 0, 0)
    end
end)

RunService.Heartbeat:Connect(function()
    if not Config.AutoParry then return end
    if not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then return end
    local ball = GetBall()
    if not ball then return end
    local velocity = ball:FindFirstChild("zoomies") and ball.zoomies.VectorVelocity or ball.AssemblyLinearVelocity
    local distance = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Magnitude
    local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 50
    local player_hitbox = 10
    local accuracy = player_hitbox + velocity.Magnitude / 3.5 + ping
    if parried then return end
    if distance <= accuracy and ball:GetAttribute('target') == LocalPlayer.Name then
        SendPureParry()
        parried = true
        ball:GetAttributeChangedSignal('target'):Connect(function()
            parried = false
        end)
        local last_parry = tick()
        task.spawn(function()
            repeat
                RunService.Heartbeat:Wait(0)
            until (tick() - last_parry) >= 2 or not parried
            parried = false
        end)
    end
end)
