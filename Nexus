        trigger = { "autoparry", "autospam", "manual" },
        manual = { "autospam", "trigger" },
    }
    local function applyMode(name, v)
        state[name] = v
        if name == "autoparry" then
            S.autoparry, S.animation = v, v
        elseif name == "autospam" then
            S.autoSpam = v
        elseif name == "trigger" then
            S.triggerEnabled = v
        elseif name == "manual" then
            S.manualSpam = v
        end
    end
    local function setMode(name, v)
        if v and not BB.Ensure() then
            if ui[name] then ui[name].Set(false) end
            return false
        end
        if v then
            for _, other in ipairs(CONFLICTS[name]) do
                if state[other] then
                    applyMode(other, false)
                    if ui[other] then ui[other].Set(false) end
                    Toast(MODE_NAMES[other] .. " выключен (конфликт с " .. MODE_NAMES[name] .. ")")
                end
            end
        end
        applyMode(name, v)
        return true
    end

